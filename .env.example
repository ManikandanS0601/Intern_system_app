DATABASE_URL=sqlite:///data/app.db
DATA_DIR=data
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
PASS_THRESHOLD=80
# Leave SMTP_HOST empty for MOCK email mode (nothing is really sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=internships@example.com
# AI provider: mock (default, keyword-evidence heuristic). Add your LLM adapter in ai_evaluate().
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
# For real chatbot answers set AI_PROVIDER=anthropic and AI_API_KEY
